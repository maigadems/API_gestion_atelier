# Exemple de configuration — copier en .env et adapter.
# NE JAMAIS committer le vrai fichier .env (il est ignoré par .gitignore).

# --- Application ---
APP_NAME=API Atelier de Couture
API_V1_PREFIX=/api/v1
DEBUG=false

# --- Base de données (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://atelier:atelier@db:5432/atelier

# --- Sécurité / JWT ---
# Générer une clé robuste, par ex. : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacer-par-une-cle-secrete-robuste
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Compte administrateur initial (créé par: python -m app.seed) ---
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=changeme123
ADMIN_NOM_COMPLET=Administrateur

# --- Variables PostgreSQL pour docker-compose ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=atelier
POSTGRES_DB=atelier
